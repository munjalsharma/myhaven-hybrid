{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/chat",
      "dest": "/chatbot.html"
    },
    {
      "src": "/team",
      "dest": "/team.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
